[12.186, "o", " \r\n"]
[12.187, "o", " The CLI has a `serve` subcommand.\r\n"]
[12.188, "o", "-- `serve` accepts `--port` (default 8000).\r\n"]
[12.189, "o", "+- `serve` accepts `--listen` (default 8000).\r\n"]
[12.189, "o", " - `serve` accepts `--host` (default 127.0.0.1).\r\n"]
[12.191, "o", "-- The `--workers` default is `4`.\r\n"]
[12.192, "o", "+- The `--workers` default is `8`.\r\n"]
[12.193, "o", " - Set `APP_DEBUG` to enable debug logging.\r\n"]
[12.193, "o", "-- Use the `migrate` subcommand to upgrade the database.\r\n"]
[12.194, "o", "+- Use the `db-upgrade` subcommand to upgrade the database.\r\n"]
[12.195, "o", " \r\n"]
[12.196, "o", " Run `make test` to check the project.\r\n"]
