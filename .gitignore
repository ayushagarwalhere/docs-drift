# Python and build output
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# uv environments and caches; keep uv.lock for reproducible development.
.venv/
venv/
.uv-cache/
.pre-commit-cache/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local scanner cache
.docs-drift/

# Generated fixture repositories (including their nested Git metadata).
/tests/fixtures/repos/
.pytest-tmp*/
.npm-cache/
node_modules/
.hypothesis/
# Full raw benchmark scans stay local; committed samples, pins, measurements and source snapshots reproduce them.
benchmark/runs/*/*--*.json
benchmark/runs/*/*.log
benchmark/runs/*/scanner-source.zip
# Screenshots written by scripts/check_html.py and scripts/check_web.py
examples/py-cli-*-*.png
examples/web-*-*-*.png
docs-drift-bench-*/
!editors/vscode/.vscode/
!editors/vscode/.vscode/launch.json
